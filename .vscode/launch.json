{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CLI prompt (debug)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder:ossm-web-controls}/.artifacts/cli-debug/OssmSharp.Cli.dll",
      "args": ["prompt"],
      "cwd": "${workspaceFolder:ossm-web-controls}",
      "console": "integratedTerminal",
      "preLaunchTask": "build CLI (debug)",
      "osx": {
        "program": "${workspaceFolder:ossm-web-controls}/src/OssmSharp.Cli/bin/Debug/net10.0-macos26.0/osx-arm64/OssmSharp.Cli.app/Contents/MacOS/OssmSharp.Cli",
        "preLaunchTask": "publish CLI"
      },
      "stopAtEntry": true
    },
    {
      "name": "Attach to CLI prompt",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
