{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CLI prompt (debug)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder:OssmSharp}/.artifacts/cli-debug/OssmSharp.Cli.dll",
      "args": ["prompt"],
      "cwd": "${workspaceFolder:OssmSharp}",
      "console": "integratedTerminal",
      "preLaunchTask": "build CLI (debug)",
      "windows": {
        "program": "${workspaceFolder:OssmSharp}/.artifacts/publish/OssmSharp.Cli/debug_net10.0-windows10.0.19041.0_win-x64/OssmSharp.Cli.exe",
        "preLaunchTask": "publish CLI"
      },
      "osx": {
        "program": "${workspaceFolder:OssmSharp}/.artifacts/bin/OssmSharp.Cli/debug_net10.0-macos27.0_osx-arm64/OssmSharp.Cli.app/Contents/MacOS/OssmSharp.Cli",
        "preLaunchTask": "publish CLI"
      },
      "stopAtEntry": false,
      "justMyCode": false,
      "symbolOptions": {
        "searchMicrosoftSymbolServer": false,
        "searchNuGetOrgSymbolServer": false
      }
    },
    {
      "name": "Attach to CLI prompt",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
