{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build CLI (debug)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder:OssmSharp}/src/OssmSharp.Cli/OssmSharp.Cli.csproj",
        "--framework",
        "net10.0",
        "--configuration",
        "Debug",
        "--output",
        "${workspaceFolder:OssmSharp}/.artifacts/cli-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder:OssmSharp}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish CLI",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder:OssmSharp}/make.ps1", "-Debug"],
      "options": {
        "cwd": "${workspaceFolder:OssmSharp}"
      },
      "problemMatcher": []
    }
  ]
}
