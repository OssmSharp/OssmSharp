<section class="widget pattern-preview device-sensitive" role="region" aria-label="@Title">
    @if (ShowHeading)
    {
        <div class="widget-heading preview-heading">
            <h2>@Title</h2>
        </div>
    }
    <svg class="preview-rail" viewBox="0 0 248 120" role="img" aria-label="@PreviewLabel">
        <path class="preview-track" d="M24 82H224 M24 76V88 M224 76V88" />
        <path class="preview-ticks" d="M74 79V85 M124 79V85 M174 79V85" />
        @if (BoundedStroke is not null && BoundedDepth is not null)
        {
            <rect class="preview-range" x="@RangeStart" y="78" width="@RangeWidth" height="8" rx="2" />
            <path class="preview-carriage" d="@CarriagePath" aria-hidden="true">
                @if (ShowAnimation)
                {
                    <animate attributeName="d" values="@AnimationValues" keyTimes="@AnimationTimes" calcMode="spline"
                             keySplines="@AnimationSplines" dur="@AnimationDuration" repeatCount="indefinite" />
                }
            </path>
            <path class="preview-still" d="@CarriagePath" aria-hidden="true" />
        }
    </svg>
</section>

@code {
    private const double RailStart = 24;
    /// <summary>User units per percent of rail travel.</summary>
    private const double Scale = 2;

    /// <summary>
    /// Gets or sets the heading and accessible region name.
    /// </summary>
    [Parameter] public string Title { get; set; } = "Pattern preview";
    /// <summary>
    /// Gets or sets whether the heading is visible. The accessible region name remains available.
    /// </summary>
    [Parameter] public bool ShowHeading { get; set; } = true;
    /// <summary>
    /// Gets or sets the illustrated pattern; null preserves an unknown pattern.
    /// </summary>
    [Parameter] public int? Pattern { get; set; } = 0;
    /// <summary>
    /// Gets or sets speed as a percentage, using 50 for 50%; null is unknown.
    /// Fractional values and values above 100 are preserved. Timing is illustrative, not physical speed.
    /// </summary>
    [Parameter] public double? Speed { get; set; }
    /// <summary>
    /// Gets or sets the illustrated travel as a percentage of rail length, from 0 to 100; null is unknown.
    /// </summary>
    [Parameter] public int? Stroke { get; set; }
    /// <summary>
    /// Gets or sets the deepest carriage position as a percentage of rail length, from 0 to 100; null is unknown.
    /// </summary>
    [Parameter] public int? Depth { get; set; }
    /// <summary>
    /// Gets or sets the illustrated pattern bias, from 0 to 100; null preserves an unknown value.
    /// </summary>
    [Parameter] public int? Sensation { get; set; }
    /// <summary>
    /// Gets or sets whether travel is animated. Zero speed or zero travel remains still;
    /// reduced-motion preferences also select the still drawing.
    /// </summary>
    [Parameter] public bool Animate { get; set; } = true;

    private string PatternLabel => Pattern switch
    {
        null => "Unknown", 0 => "Simple stroke", 1 => "Teasing / pounding", 2 => "Robo stroke",
        3 => "Half / half", 4 => "Deeper", 5 => "Stop / go", 6 => "Insist", _ => $"Pattern {Pattern}",
    };
    private int? BoundedStroke => Bound(Stroke);
    private int? BoundedDepth => Bound(Depth);
    private int? BoundedSensation => Bound(Sensation);
    private double Start => RailStart + Math.Max(0, BoundedDepth!.Value - BoundedStroke!.Value) * Scale;
    private double End => RailStart + BoundedDepth!.Value * Scale;
    private double Mid => (Start + End) / 2;
    private string RangeStart => Format(Start);
    private string RangeWidth => Format(Math.Max(1, End - Start));
    private double CarriageX => (Pattern == 6 ? Start + _positions[0] * (End - Start) : Mid) - 18;
    private string CarriagePath => Shape(CarriageX);
    private double[] _positions = [0, 1, 0];
    private double[] _times = [0, .5, 1];
    private double _cycles = 1;
    private bool ShowAnimation => Animate && Speed > 0 && double.IsFinite(Speed.Value) && End > Start
        && Pattern is >= 0 and <= 6 && (Pattern == 0 || BoundedSensation is not null) && _positions.Distinct().Count() > 1;
    private string AnimationValues => string.Join(';', _positions.Select(position => Shape(Travel(position))));
    private string AnimationTimes => string.Join(';', _times.Select(time => time.ToString("0.######", CultureInfo.InvariantCulture)));
    private string AnimationSplines => string.Join(';', Enumerable.Repeat(Pattern == 2 ? "0 0 1 1" : ".33 0 .67 1", _positions.Length - 1));
    private string AnimationDuration => FormattableString.Invariant($"{40 * _cycles / Speed:0.####}s");
    private string PreviewLabel => $"{PatternLabel} preview at {Value(Speed)} speed, {Value(BoundedStroke)} stroke, {Value(BoundedDepth)} depth, and {Value(BoundedSensation)} sensation";

    protected override void OnParametersSet()
    {
        var sensation = BoundedSensation.GetValueOrDefault(50);
        var bias = (sensation - 50) / 50.0;
        var insertionTime = bias >= 0 ? .5 / (1 + 4 * bias) : 1 - .5 / (1 - 4 * bias);
        _positions = [0, 1, 0];
        _times = [0, .5, 1];
        _cycles = 1;
        switch (Pattern)
        {
            case 1:
                _times = [0, insertionTime, 1];
                break;
            case 2:
                var dwell = .05 + sensation / 100.0 * .2;
                _positions = [0, 1, 1, 0, 0];
                _times = [0, .5 - dwell, .5, 1 - dwell, 1];
                break;
            case 3:
                _positions = [0, .5, 0, 1, 0];
                _times = [0, insertionTime / 2, .5, .5 + insertionTime / 2, 1];
                _cycles = 2;
                break;
            case 4:
                var count = sensation < 50 ? 2 + sensation * 9 / 50 : 11 + (sensation - 50) * 21 / 50;
                _positions = Enumerable.Range(0, count * 2 + 1).Select(index => index % 2 == 0 ? 0 : (index + 1) / (2.0 * count)).ToArray();
                _times = Enumerable.Range(0, _positions.Length).Select(index => index / (double)(_positions.Length - 1)).ToArray();
                _cycles = count;
                break;
            case 5:
                var positions = new List<double> { 0 };
                var times = new List<double> { 0 };
                var elapsed = 0.0;
                foreach (var strokes in new[] { 1, 2, 3, 4, 5, 4, 3, 2 })
                {
                    for (var stroke = 0; stroke < strokes; stroke++)
                    {
                        positions.AddRange([1, 0]);
                        times.AddRange([elapsed + .5, elapsed + 1]);
                        elapsed++;
                    }
                    elapsed += .25 + sensation / 25.0;
                    positions.Add(0);
                    times.Add(elapsed);
                }
                _positions = positions.ToArray();
                _times = times.Select(time => time / elapsed).ToArray();
                _cycles = elapsed;
                break;
            case 6:
                var fraction = 1 - Math.Abs(bias);
                _positions = bias > 0 ? [1 - fraction, 1, 1 - fraction] : [0, fraction, 0];
                _cycles = Math.Max(.01, fraction);
                break;
        }
    }

    private double Travel(double position) => Start + position * (End - Start) - 18;
    private static int? Bound(int? value) => value is { } known ? Math.Clamp(known, 0, 100) : null;
    private static string Shape(double position) => $"M{Format(position)} 58H{Format(position + 18)}V80H{Format(position)}Z";
    private static string Value(double? value) => value is { } known ? FormattableString.Invariant($"{known}%") : "Unknown";
    private static string Format(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);
}
