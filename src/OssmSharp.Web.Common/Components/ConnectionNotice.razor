<InlineNotification id="app-boot-status" CssClass="rw-boot-notice" Variant="info" Role="status">
    <span data-boot-text>Connecting...</span>
</InlineNotification>
<div id="components-reconnect-modal" class="rw-connection-notice components-reconnect-hide" role="status">
    <InlineNotification CssClass="rw-reconnect-pending" Variant="warning">Rejoining the server...</InlineNotification>
    <InlineNotification CssClass="rw-reconnect-failed" Variant="danger">Connection lost.</InlineNotification>
</div>
<InlineNotification id="blazor-error-ui" CssClass="rw-fatal-notice" Variant="danger" Role="alert">
    Connection lost.
</InlineNotification>
