<div class="setting-channel" data-slider="@Name" data-state="@State">
  <div class="slider-heading">
    <label for="@($"guest-{Name}")">@Label</label>
    <div class="selected-readout"><output for="@($"guest-{Name}")" data-value="@Name">@SelectedValue</output><span class="readout-unit" aria-hidden="true">%</span></div>
  </div>
  <div class="slider-well">
    <input class="setting-range" id="@($"guest-{Name}")" data-input="@Name" type="range" min="@Minimum"
           max="@Maximum" value="@InitialValue" step="1" aria-orientation="horizontal" />
    <svg class="slider-markers" viewBox="0 0 100 12" preserveAspectRatio="none" aria-hidden="true">
      <line class="current-marker" data-current-marker="@Name" x1="0" x2="0" y1="0" y2="12" hidden />
      <line class="sent-marker" data-sent-marker="@Name" x1="0" x2="0" y1="0" y2="12" hidden />
    </svg>
  </div>
  <div class="setting-values">
    <span>Sent <strong data-sent="@Name">@(SentValue?.ToString() ?? "--")</strong></span>
    <span>Current <strong data-current="@Name">@(CurrentValue?.ToString() ?? "--")</strong></span>
  </div>
</div>

@code {
  [Parameter, EditorRequired] public string Name { get; set; } = "";
  [Parameter, EditorRequired] public string Label { get; set; } = "";
  [Parameter] public int Minimum { get; set; }
  [Parameter] public int Maximum { get; set; } = 100;
  [Parameter] public int InitialValue { get; set; }
  [Parameter] public int SelectedValue { get; set; }
  [Parameter] public int? SentValue { get; set; }
  [Parameter] public double? CurrentValue { get; set; }
  private string State => SentValue is null || SelectedValue != SentValue ? "unsent" : "sent";
}
