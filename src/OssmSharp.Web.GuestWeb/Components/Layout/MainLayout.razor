@inherits LayoutComponentBase

<ControlLayout Label="Guest controls" ShowHeader="false">
    <ChildContent>
        <InlineNotification Variant="warning" Role="alert" data-testid="guest-disconnected">
            <span data-session-message>Connection lost. Reconnecting automatically. Motion will not restart.</span>
        </InlineNotification>
        @Body
    </ChildContent>
</ControlLayout>
