@page "/join"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using OssmSharp.Web.Client.Models

<PageTitle>Guest controls</PageTitle>

@if (_connectionLost && _status is not { Joined: true })
{
  <InlineNotification Variant="danger" Role="alert">
    Connection lost. Open the invitation link again.
  </InlineNotification>
}
else if (!_connectionLost && _initialized && !_joined && !_joining)
{
  <InlineNotification Variant="danger" Role="alert" data-testid="@(_everJoined ? "guest-ended" : "guest-invalid")">
    @(_everJoined ? "Session ended. Open the invite link again to rejoin." : "This invitation is invalid or has been replaced.")
  </InlineNotification>
}
else if (!_joined && !_connectionLost)
{
  <InlineNotification Variant="info" Role="status">Opening invite...</InlineNotification>
}
else
{
  <div @ref="_root" class="guest-session rw-stack" data-connection-lost="@(_connectionLost ? "true" : null)"
      data-device-disconnected="@((_status?.Device).IsConnectedForControls ? null : "true")">
    <InlineNotification Variant="danger" Role="alert" data-browser-alert hidden="@(_display.Error is null)">
      @_display.Error
    </InlineNotification>
    <div class="guest-interface connection-sensitive device-sensitive rw-stack">
      <InlineNotification Variant="@SessionMessageVariant" CssClass="guest-session-message" Role="status">
        @SessionMessage</InlineNotification>
        <PatternPreview Speed="@(_display.Selected.Speed * _display.Selected.Stroke / 100)"
                        Stroke="@_display.Selected.Stroke" Depth="@_display.Selected.Depth" Sensation="@_display.Selected.Sensation"
                        Animate="@(!_connectionLost && (_status?.Device).IsConnectedForControls)" />
        <RwCard role="region" aria-label="Requested settings">
          <div slot="heading" class="rw-card-heading">
            <h2>Settings</h2>
          </div>
          <div class="settings-legend">
            <span><i class="key selected" aria-hidden="true"></i>Selected</span>
            <span><i class="key sent" aria-hidden="true"></i>Sent</span>
            <span><i class="key current" aria-hidden="true"></i>Last known</span>
          </div>
          <div class="slider-grid">
            <VerticalSlider Name="speed" Label="Speed" Maximum="100" InitialValue="0"
                            SelectedValue="@_display.Selected.Speed" SentValue="@_display.Sent?.Speed" CurrentValue="@DeviceSpeed" />
            <VerticalSlider Name="stroke" Label="Stroke" Minimum="1" Maximum="100" InitialValue="10"
                            SelectedValue="@_display.Selected.Stroke" SentValue="@_display.Sent?.Stroke"
                            CurrentValue="@_status?.Device?.Stroke" />
            <VerticalSlider Name="depth" Label="Depth" Minimum="1" Maximum="100" InitialValue="20"
                            SelectedValue="@_display.Selected.Depth" SentValue="@_display.Sent?.Depth"
                            CurrentValue="@_status?.Device?.Depth" />
          </div>
          <div slot="footer" class="card-footer">
            <div class="send-bar">
              <rw-toggle class="auto-send">
                <input slot="control" id="guest-auto-send" type="checkbox" data-auto-send disabled="@(!Ready)" />
                <label slot="label" for="guest-auto-send">Auto send</label>
              </rw-toggle>
              <RwButton Type="button" Variant="success" data-send-button Disabled="@(!Ready)" aria-label="Send"
                        title="Send the selected settings">Send</RwButton>
              <RwButton Type="button" Variant="danger" data-stop-button Disabled="@_connectionLost" aria-label="Stop"
                        title="Stop motion and pause control">Stop</RwButton>
            </div>
            @if (Ready)
            {
              <p data-send-status class="send-status" role="status">@_display.Status</p>
            }
          </div>
        </RwCard>
        <div class="rw-actions">
          <RwButton Type="button" Variant="secondary" OnClick="LeaveAsync" Disabled="@(_leaving || _connectionLost)"
                    aria-label="Leave session" title="Stop control and leave this session">Leave session</RwButton>
        </div>
      </div>
    </div>
  }
