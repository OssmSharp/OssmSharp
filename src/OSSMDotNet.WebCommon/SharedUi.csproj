<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <RootNamespace>OSSMDotNet.WebCommon</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="RetroWebUi.Blazor" GeneratePathProperty="true" />
    </ItemGroup>
    <Target Name="VerifyRetroWidgetPackage" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
        <GetFileHash Files="$(PkgRetroWebUi_Blazor)\retrowebui.blazor.0.1.4.nupkg" Algorithm="SHA256">
            <Output TaskParameter="Items" ItemName="_RetroPackageHash" />
        </GetFileHash>
        <Error Condition="'%(_RetroPackageHash.FileHash)' != '211B8292AA4FD67D06262F565F039C72007C311B7F6E0E16B5A212A4FF3F3296'"
               Text="The local RetroWebUi.Blazor package differs from the reviewed 0.1.4 artifact. Restore the documented artifact or review its widget styles and update the package/CSP hashes together." />
    </Target>
</Project>
