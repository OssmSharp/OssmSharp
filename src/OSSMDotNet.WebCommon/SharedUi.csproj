<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <RootNamespace>OSSMDotNet.WebCommon</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="RetroWebUi.Blazor" GeneratePathProperty="true" />
    </ItemGroup>
    <Target Name="VerifyRetroWidgetPackage" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
        <GetFileHash Files="$(PkgRetroWebUi_Blazor)\retrowebui.blazor.0.1.5.nupkg" Algorithm="SHA256">
            <Output TaskParameter="Items" ItemName="_RetroPackageHash" />
        </GetFileHash>
        <Error Condition="'%(_RetroPackageHash.FileHash)' != '41B03D19F84BDC2332FBAEFEC7CDEE48A2D5948904F172DCE4F27D54195B75E8'"
               Text="The local RetroWebUi.Blazor package differs from the reviewed 0.1.5 artifact. Restore the documented artifact or review its widget styles and update the package/CSP hashes together." />
    </Target>
</Project>
