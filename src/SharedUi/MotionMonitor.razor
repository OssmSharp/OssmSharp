<RwCard class="@(Fresh ? "motion-monitor" : "motion-monitor offline")" role="region" aria-label="Live device feedback">
    <div slot="heading" class="monitor-heading">
        <span>Live feedback</span>
        <RwBadge Variant="@(Fresh ? "success" : "warning")">@(Fresh ? "Connected" : "No signal")</RwBadge>
    </div>
    <div class="motion-reading">
        <h2 class="@(Fresh && (Enabled || Moving) ? "moving" : "")" role="status">@(Fresh ? Enabled || Moving ? "RUNNING" : "IDLE" : "OFFLINE")</h2>
        <div class="telemetry"><strong data-testid="live-position">@Number(Position)</strong><span>mm</span></div>
    </div>
    <svg class="motion-rail" viewBox="0 0 200 36" role="img" aria-label="Reported carriage position">
        <path class="rail" d="M5 18H195 M5 11V25 M195 11V25" />
        <path class="rail-ticks" d="M52 14V22 M100 14V22 M148 14V22" />
        @if (Fresh && Position is not null)
        {
            <rect class="carriage" x="@MarkerX" y="8" width="8" height="20" />
        }
    </svg>
    <div slot="footer" class="monitor-footer">
        <span>@(IsSimulator ? "Position from the simulator" : "Position")</span>
        <span><strong data-testid="live-velocity">@Number(Velocity)</strong> mm/s</span>
    </div>
</RwCard>

@code {
    [Parameter] public double? Position { get; set; }
    [Parameter] public double? Velocity { get; set; }
    [Parameter] public bool Moving { get; set; }
    [Parameter] public bool Fresh { get; set; }
    [Parameter] public bool Enabled { get; set; }
    [Parameter] public bool IsSimulator { get; set; }

    private string MarkerX => (5 + Math.Clamp(Position ?? 0, 0, 190) / 190 * 182).ToString("0.##", CultureInfo.InvariantCulture);
    private string Number(double? value) => Fresh && value is { } number && double.IsFinite(number)
        ? number.ToString("0.0", CultureInfo.InvariantCulture) : "--";
}
