<Project Sdk="Microsoft.NET.Sdk.Razor">
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="RetroWebUi.Blazor" Version="[0.1.3]" GeneratePathProperty="true" />
    </ItemGroup>
    <Target Name="VerifyRetroWidgetPackage" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
        <GetFileHash Files="$(PkgRetroWebUi_Blazor)\retrowebui.blazor.0.1.3.nupkg" Algorithm="SHA256">
            <Output TaskParameter="Items" ItemName="_RetroPackageHash" />
        </GetFileHash>
        <Error Condition="'%(_RetroPackageHash.FileHash)' != 'E38BECE52DC36156F8AB6ABEEE7B22481AF87A0D72712EDB0CB34D7C0F615304'"
               Text="The local RetroWebUi.Blazor package differs from the reviewed 0.1.3 artifact. Restore the documented artifact or review its widget styles and update the package/CSP hashes together." />
    </Target>
</Project>
