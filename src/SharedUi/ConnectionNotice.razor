<RwAlert id="app-boot-status" class="rw-notice rw-boot-notice" Variant="info" role="status">
    <span data-boot-text>Connecting...</span>
</RwAlert>
<div id="components-reconnect-modal" class="rw-notice rw-connection-notice components-reconnect-hide" role="status">
    <RwAlert class="rw-reconnect-pending" Variant="warning">Rejoining the server...</RwAlert>
    <RwAlert class="rw-reconnect-failed" Variant="danger">Connection lost.</RwAlert>
</div>
<div id="blazor-error-ui" class="rw-notice rw-fatal-notice" role="alert">
    <RwAlert Variant="danger">Connection lost.</RwAlert>
</div>
