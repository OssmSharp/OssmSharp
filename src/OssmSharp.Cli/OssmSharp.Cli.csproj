<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>OssmSharp.Cli</AssemblyName>
    <RootNamespace>OssmSharp.Cli</RootNamespace>
    <ApplicationId Condition="'$(TargetFramework)' == 'net10.0-macos26.0'">org.ossm.devicecli</ApplicationId>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableStockBle)' == 'true' and $([MSBuild]::IsOSPlatform('OSX'))">
    <TargetFramework>net10.0-macos26.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableStockBle)' == 'true' and $([MSBuild]::IsOSPlatform('Windows'))">
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Shiny.BluetoothLE"
      Condition="'$(TargetFramework)' == 'net10.0-macos26.0' or '$(TargetFramework)' == 'net10.0-windows10.0.19041.0'" />
    <ProjectReference Include="../OssmSharp.Device.Primitives/OssmSharp.Device.Primitives.csproj" />
    <ProjectReference Include="../OssmSharp.Device.Runtime/OssmSharp.Device.Runtime.csproj" />
    <ProjectReference Include="../OssmSharp.Device.Stock/OssmSharp.Device.Stock.csproj" />
    <ProjectReference Include="../OssmSharp.Device.Simulator/OssmSharp.Device.Simulator.csproj" />
    <Using Include="OssmSharp.Device.Primitives.Models" />
    <Using Include="OssmSharp.Cli.Commands" />
    <Using Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OssmSharp.Cli.Tests" />
    <InternalsVisibleTo Include="OssmSharp.Cli.IntegrationTests" />
  </ItemGroup>
</Project>
