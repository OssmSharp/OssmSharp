<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework />
    <TargetFrameworks>$(BaseTargetFramework)</TargetFrameworks>
    <TargetFrameworks Condition="'$(NativeTargetFramework)' != ''">
      $(TargetFrameworks);$(NativeTargetFramework)</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'">
    <!-- Native macOS builds use the host architecture unless RIDs were explicitly selected. -->
    <RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$(RuntimeIdentifier)' == '' And '$(RuntimeIdentifiers)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <NoWarn>$(NoWarn);XCODE_27_0_PREVIEW</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../OssmSharp.Runtime.Oem/OssmSharp.Runtime.Oem.csproj" />
    <PackageReference Include="PrettyPrompt" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <InternalsVisibleTo Include="OssmSharp.Cli.Tests" />
  </ItemGroup>
</Project>
