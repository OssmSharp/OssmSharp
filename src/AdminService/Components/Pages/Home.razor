@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>Operator controls</PageTitle>
<ControlLayout Label="Operator controls">
    <Header>
        <span class="site-label">Operator controls</span>
        @if (_status?.IsSimulator == true) { <RwBadge Variant="info">SIMULATOR</RwBadge> }
    </Header>
    <ChildContent>
    @if (_status is null)
    {
        <RwAlert Variant="@(_loaded ? "danger" : "info")" class="rw-notice rw-operation-notice" role="alert">
            @(_loaded ? "Connection unavailable. Reload the operator page." : "Connecting...")
        </RwAlert>
    }
    else
    {
        <h1 class="visually-hidden">Operator controls</h1>
        @if (_notice.Message is { } message)
        {
            <RwAlert class="rw-notice rw-operation-notice" Variant="@(_notice.IsError ? "danger" : "info")"
                     role="@(_notice.IsError ? "alert" : "status")">@message</RwAlert>
        }
        <details class="feedback-disclosure">
            <summary>Live feedback <span class="hint">@(_status.BridgeReady ? "Connected" : "No signal")</span></summary>
            <MotionMonitor Position="@_status.Position" Velocity="@_status.Velocity"
                           Moving="@_status.DeviceMoving" Enabled="@_status.DeviceEnabled"
                           Fresh="@_status.BridgeReady" IsSimulator="@_status.IsSimulator" />
        </details>
        <RwCard class="operator-status" role="region" aria-label="Operator actions">
            <div slot="heading" class="rw-card-heading">
                <h2 data-testid="controller-mode">@ModeLabel</h2>
                <RwBadge Variant="@SessionVariant" data-testid="session-mode">@SessionLabel</RwBadge>
            </div>
            <div class="rw-actions">
                @if (_status.Mode == "Locked")
                {
                    <RwButton Type="button" Variant="primary" Disabled="@(!CanReset)" OnClick="Unlock"
                              aria-label="Unlock" title="Unlock into paused control">Unlock</RwButton>
                }
                else if (_status.Mode == "Faulted")
                {
                    <RwButton Type="button" Variant="primary" Disabled="@(!CanReset)" OnClick="Reset"
                              aria-label="Reset connection" title="Reset the device connection without enabling control">Reset connection</RwButton>
                }
                else
                {
                    <RwButton Type="button" Variant="@(GuestWaiting ? "success" : "primary")"
                              class="@(GuestWaiting && CanAllow ? "rw-attention" : null)" Disabled="@(!CanAllow)" OnClick="AllowControl"
                              aria-label="Allow control" title="Approve the guest and enable control">Allow control</RwButton>
                }
                <RwButton Type="button" Variant="warning" Disabled="@(_status.SessionMode is "None" or "Ended")" OnClick="End"
                          aria-label="Stop and end session" title="Stop motion, revoke the guest and replace the invitation link">Stop and end session</RwButton>
            </div>
            @if (_status.Mode == "Locked") { <p class="hint">External changes detected. Unlock leaves control paused.</p> }
            else if (!_status.BridgeReady) { <p class="hint">Waiting for device feedback.</p> }
            else if (_status.OperationPending) { <p class="hint">Waiting for the device to settle.</p> }
            else if (_status.Limits.SpeedCap <= 0 || _status.Limits.MaximumDepth <= 0) { <p class="hint needs-attention">Control is disabled by the current limits.</p> }
            else if (_status.SessionMode is "None" or "Ended") { <p class="hint">Waiting for a guest to join.</p> }
        </RwCard>
        <div class="operator-grid">
            <RwCard role="region" aria-labelledby="limits-heading">
                <div slot="heading" class="rw-card-heading">
                    <h2 id="limits-heading">Session limits</h2>
                    @if (_cap != _status.Limits.SpeedCap || _depth != _status.Limits.MaximumDepth)
                    {
                        <RwBadge Variant="warning" data-testid="limits-dirty">Not applied</RwBadge>
                    }
                </div>
                <div class="form-grid">
                    <div class="limit-field">
                        <div class="limit-heading">
                            <label for="operator-speed-cap">Speed cap (%)</label>
                            <output for="operator-speed-cap">@(_cap)%</output>
                        </div>
                        <RwRange id="operator-speed-cap" Minimum="0" Maximum="100" Step="1"
                                 Value="@_cap" ValueChanged="@(value => _cap = checked((int)value))"
                                 AppliedValue="@_status.Limits.SpeedCap" aria-describedby="limits-help" />
                    </div>
                    <div class="limit-field">
                        <div class="limit-heading">
                            <label for="operator-maximum-depth">Maximum depth (%)</label>
                            <output for="operator-maximum-depth">@(_depth)%</output>
                        </div>
                        <RwRange id="operator-maximum-depth" Minimum="1" Maximum="100" Step="1"
                                 Value="@_depth" ValueChanged="@(value => _depth = checked((int)value))"
                                 AppliedValue="@_status.Limits.MaximumDepth" aria-describedby="limits-help" />
                    </div>
                </div>
                <div slot="footer" class="card-footer">
                    <div class="rw-actions">
                        <RwButton Type="button" Variant="primary" Disabled="@(!_status.BridgeReady || _status.Mode is "Locked" or "Faulted")" OnClick="ApplyLimits"
                                  aria-label="Apply limits" title="Apply the selected limits without pausing control">Apply limits</RwButton>
                        <p id="limits-help" class="hint">Apply without pausing. Current settings must fit.</p>
                    </div>
                </div>
            </RwCard>
            <RwCard role="region" aria-labelledby="invite-heading">
                <h2 slot="heading" id="invite-heading">Invite a guest</h2>
                @if (_invitation is not null)
                {
                    <div class="invite-row rw-controls-row">
                        <rw-input>
                            <input slot="control" id="guest-invitation" type="text" aria-label="Guest invitation"
                                   data-testid="invitation-link" readonly value="@_invitation.Url" />
                        </rw-input>
                        <RwButton class="rw-feedback-button" Type="button" Variant="@(_notice.IsCopied ? "success" : "secondary")" OnClick="Copy"
                                  aria-label="@_notice.CopyLabel" title="@(_notice.IsCopied ? "Invitation link copied" : "Copy invitation link")">@_notice.CopyLabel</RwButton>
                        <RwButton class="rw-icon-button" Type="button" Variant="secondary" Disabled="@_busy" OnClick="Cycle"
                                  aria-label="Cycle link" title="Cycle link" aria-describedby="cycle-help">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M20 7v5h-5M4 17v-5h5M6.1 6.1A8 8 0 0 1 20 12M4 12a8 8 0 0 0 13.9 5.9" />
                            </svg>
                        </RwButton>
                    </div>
                    <p class="hint">Share this link with someone.</p>
                    <span id="cycle-help" class="visually-hidden">Replace the link, revoke the current guest and request Stop.</span>
                }
            </RwCard>
        </div>
        <RwCard class="activity-panel" role="region" aria-labelledby="activity-heading">
            <h2 slot="heading" id="activity-heading">Live log</h2>
            <div class="live-log" @ref="_logElement" role="log" aria-live="polite" aria-relevant="additions" tabindex="0">
                <div class="log-lines">
                    @if (_logs.Count == 0) { <p class="log-empty">Waiting for activity...</p> }
                    @foreach (var entry in _logs)
                    {
                        <div @key="entry.Sequence" class="log-entry @LogClass(entry.Level)">
                            <time>@entry.Timestamp.ToLocalTime().ToString("HH:mm:ss")</time>
                            <span>@entry.Message</span>
                        </div>
                    }
                </div>
            </div>
        </RwCard>
    }
    </ChildContent>
</ControlLayout>
