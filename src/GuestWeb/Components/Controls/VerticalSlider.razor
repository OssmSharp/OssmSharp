<div class="vertical-slider" data-slider="@Name">
    <div class="slider-heading">
        <label for="@($"guest-{Name}")">@Label</label>
        <output for="@($"guest-{Name}")" data-value="@Name">@InitialValue</output>
    </div>
    <div class="slider-well">
        <svg class="slider-markers" viewBox="0 0 26 100" preserveAspectRatio="none" aria-hidden="true">
            <line class="current-marker" data-current-marker="@Name" x1="0" x2="24" y1="100" y2="100" hidden />
            <line class="sent-marker" data-sent-marker="@Name" x1="0" x2="24" y1="100" y2="100" hidden />
        </svg>
        <input class="vertical-range" id="@($"guest-{Name}")" data-input="@Name" type="range"
               min="@Minimum" max="@Maximum" value="@InitialValue" step="1" aria-orientation="vertical" />
    </div>
    <div class="setting-values">
        <span>Sent <strong data-sent="@Name">--</strong></span>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public int Minimum { get; set; }
    [Parameter] public int Maximum { get; set; } = 100;
    [Parameter] public int InitialValue { get; set; }
}
