@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>Operator controls</PageTitle>
<ControlLayout Label="Operator controls">
  <HeaderContent>
    @if (_status?.IsSimulator == true)
    {
      <div class="operator-page-header-status" data-testid="operator-page-header-status">
        <RwBadge Variant="info" data-testid="simulator-mode">SIMULATOR</RwBadge>
      </div>
    }
  </HeaderContent>
  <ChildContent>
    @if (_status is null)
    {
      <InlineNotification Variant="@(_loaded ? "danger" : "info")" Role="@(_loaded ? "alert" : "status")">
        @(_notice.Message ?? (_loaded ? "Unable to connect to the operator service. Reload the page." : "Connecting..."))
      </InlineNotification>
    }
    else
    {
      <h1 class="visually-hidden">Operator controls</h1>
      @if (_notice.Message is { } message)
      {
        <InlineNotification Variant="@(_notice.IsError ? "danger" : "success")"
                            Role="@(_notice.IsError ? "alert" : "status")">@message</InlineNotification>
      }
      @if (GuestApprovalActionAvailable)
      {
        <InlineNotification Variant="warning" Role="status" data-testid="pending-guest-notice">A guest is waiting. Click Allow control to enable control.</InlineNotification>
        }
        <details class="feedback-disclosure">
          <summary data-testid="live-feedback">Live feedback</summary>
          <MotionMonitor ShowHeading="false" Position="@_status.Position" Velocity="@_status.Velocity"
                         Moving="@_status.DeviceMoving" Enabled="@_status.DeviceEnabled" Fresh="@_status.BridgeReady"
                         IsSimulator="@_status.IsSimulator" />
        </details>
        <div class="operator-grid">
          <RwCard class="operator-status" data-testid="operator-controls" role="region" aria-label="Operator actions">
            <div slot="heading" class="rw-card-heading operator-status-heading">
              <h2 data-testid="controller-mode">Controls</h2>
              <div class="operator-status-badges" data-testid="operator-status-badges">
                @if (OperationPending)
                {
                  <span class="operator-operation-status" data-testid="operator-operation-status" role="img"
                        aria-label="@PendingOperationStatusText" title="@PendingOperationStatusText">●</span>
                }
                <RwBadge Variant="@SessionVariant" data-testid="session-mode">@SessionLabel</RwBadge>
              </div>
            </div>
            <div class="rw-actions">
              @if (_status.Mode == "Locked")
              {
                <RwButton Type="button" Variant="primary" Disabled="@(!CanReset)" OnClick="Unlock" aria-label="Unlock"
                          title="Unlock into paused control">Unlock</RwButton>
              }
              else if (_status.Mode == "Faulted")
              {
                <RwButton Type="button" Variant="primary" Disabled="@(!CanReset)" OnClick="Reset"
                          aria-label="Reset connection" title="Reset the device connection without enabling control">Reset connection
                </RwButton>
              }
              else
              {
                <RwButton Type="button" Variant="success" Disabled="@(!CanAllow)" OnClick="AllowControl"
                          aria-label="Allow control" title="Approve the guest and enable control">Allow control</RwButton>
              }
              <RwButton Type="button" Variant="danger" Disabled="@(_status.SessionMode is "None" or "Ended")" OnClick="End"
                        aria-label="Stop and end session" title="Stop motion, revoke the guest and replace the invitation link">Stop
                and end session</RwButton>
              </div>
              @if (_status.Mode == "Locked")
              {
                <p class="hint">External changes detected. Unlock leaves control paused.</p>
              }
              else if (!_status.BridgeReady)
              {

                <p class="hint">Waiting for device feedback.</p>
              }
              else if (_status.Limits.SpeedCap <= 0 || _status.Limits.MaximumDepth <= 0)
              {

                <p class="hint needs-attention">
                  Control is disabled by the current limits.</p>
                }
                else if (_status.SessionMode is "None" or "Ended")
                {

                  <p class="hint">Waiting for a guest to join.</p>
                }
              </RwCard>
              <RwCard data-testid="guest-invitation-card" role="region" aria-labelledby="invite-heading">
                <div slot="heading" class="rw-card-heading">
                  <h2 id="invite-heading">Invite a guest</h2>
                </div>
                @if (_invitation is not null)
                {
                  <div class="invite-row rw-controls-row">
                    <rw-input>
                      <input slot="control" id="guest-invitation" type="text" aria-label="Guest invitation link"
                             data-testid="invitation-link" readonly value="@_invitation.Url" />
                    </rw-input>
                    <RwButton class="rw-feedback-button" Type="button" Variant="@(_notice.IsCopied ? "success" : "secondary")"
                              OnClick="Copy" aria-label="@_notice.CopyLabel"
                              title="@(_notice.IsCopied ? "Invitation link copied" : "Copy invitation link")">@_notice.CopyLabel
                    </RwButton>
                    <RwButton class="rw-icon-button cycle-invitation-button" Type="button" Variant="secondary" Disabled="@_busy"
                              OnClick="Cycle" aria-label="Replace invitation link"
                              title="Replace the invitation link, revoke the current guest, and request Stop"
                              aria-describedby="cycle-help">
                      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M20 7v5h-5M4 17v-5h5M6.1 6.1A8 8 0 0 1 20 12M4 12a8 8 0 0 0 13.9 5.9" />
                      </svg>
                    </RwButton>
                  </div>
                  <p class="hint">Share this link with the guest.</p>
                  <span id="cycle-help" class="visually-hidden">Replaces the invitation link, revokes the current guest, and
                    requests Stop.</span>
                  }
                </RwCard>
                <RwCard class="session-limits" data-testid="session-limits" role="region" aria-labelledby="limits-heading">
                  <div slot="heading" class="rw-card-heading limits-card-heading">
                    <h2 id="limits-heading">Session limits</h2>
                    @if (_speedCap != _status.Limits.SpeedCap || _maximumDepth != _status.Limits.MaximumDepth)
                    {
                      <RwBadge Variant="warning" data-testid="limits-dirty">Not applied</RwBadge>
                    }
                  </div>
                  <div class="limits-controls" data-testid="limits-controls">
                    <div class="limit-field">
                      <div class="limit-heading">
                        <label for="operator-speed-cap">Speed cap (%)</label>
                        <output for="operator-speed-cap">@(_speedCap)%</output>
                      </div>
                      <RwRange id="operator-speed-cap" Minimum="0" Maximum="100" Step="1" Value="@_speedCap"
                               ValueChanged="@(value => _speedCap = checked((int)value))"
                               AppliedValue="@(_speedCap == _status.Limits.SpeedCap ? null : _status.Limits.SpeedCap)" />
                    </div>
                    <div class="limit-field">
                      <div class="limit-heading">
                        <label for="operator-maximum-depth">Maximum depth (%)</label>
                        <output for="operator-maximum-depth">@(_maximumDepth)%</output>
                      </div>
                      <RwRange id="operator-maximum-depth" Minimum="1" Maximum="100" Step="1" Value="@_maximumDepth"
                               ValueChanged="@(value => _maximumDepth = checked((int)value))"
                               AppliedValue="@(_maximumDepth == _status.Limits.MaximumDepth ? null : _status.Limits.MaximumDepth)" />
                    </div>
                    <RwButton class="apply-limits" Type="button" Variant="primary"
                              Disabled="@(!_status.BridgeReady || _status.Mode is "Locked" or "Faulted")" OnClick="ApplyLimits"
                              aria-label="Apply limits" title="Apply the selected limits without pausing control">Apply limits</RwButton>
                  </div>
                </RwCard>
              </div>
              <RwCard class="activity-panel" role="region" aria-labelledby="activity-heading">
                <div slot="heading" class="rw-card-heading">
                  <h2 id="activity-heading">Activity log</h2>
                </div>
                <div class="live-log" @ref="_logElement" role="log" aria-live="polite" aria-relevant="additions" tabindex="0">
                  <div class="log-lines">
                    @if (_logs.Count == 0)
                    {
                      <p class="log-empty">Waiting for activity.</p>
                    }
                    @foreach (var entry in _logs)
                    {
                      <div @key="entry.Sequence" class="log-entry @LogClass(entry.Level)">
                        <time>@entry.Timestamp.ToLocalTime().ToString("HH:mm:ss")</time>
                        <span>@entry.Message</span>
                      </div>
                    }
                  </div>
                </div>
              </RwCard>
            }
          </ChildContent>
        </ControlLayout>
