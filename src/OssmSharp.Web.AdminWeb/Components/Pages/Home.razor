@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using OssmSharp.Web.Client.Models

@{
  var deviceConnected = _state?.Device is { IsConnected: true, IsConnecting: false };
  var guestConnected = _state is { GuestJoined: true, GuestConnected: true };
}

<PageTitle>User controls</PageTitle>
<ControlLayout Label="User controls" ConnectionLost="@_connectionLost">
  <HeaderContent>
    @if (deviceConnected)
    {
      <div class="device-summary connection-sensitive" data-testid="device-connection" role="group" aria-label="Connected device">
        <span class="status-mark connection-badge @ConnectionVariant" data-testid="device-connection-status" role="status">@ConnectionStatus</span>
        <span data-testid="device-name">@(_state?.Device?.Name ?? "Unknown")</span>
        <span class="device-identifier" data-testid="device-identifier">@(_state?.Device?.Identifier ?? "Unknown")</span>
      </div>
    }
  </HeaderContent>
  <ChildContent>
    <section class="experience-intro" aria-labelledby="session-title">
      <p class="eyebrow">YOUR DEVICE · YOUR SESSION</p>
      <h1 id="session-title">@(_connectionLost ? "Connection needs attention" : !deviceConnected ? "Start with your device" : !guestConnected ? "Bring someone in" : _state?.GuestControlAllowed == true ? "You're connected" : "Ready when you are")</h1>
      <p>@(_connectionLost ? "Check the connection before continuing. Motion will not restart automatically." : !deviceConnected ? "Connect your device, then share a private invitation." : !guestConnected ? "Share a single-use invitation. You decide when your guest can take control." : _state?.GuestControlAllowed == true ? "Your guest can send settings. Keep Stop within reach throughout the session." : "Your guest has joined. Confirm you're ready before allowing control.")</p>
      <ol class="session-steps" aria-label="Session setup">
        <li aria-current="@(!deviceConnected ? "step" : null)"><span>01</span> Connect device</li>
        <li aria-current="@(deviceConnected && !guestConnected ? "step" : null)"><span>02</span> Invite a guest</li>
        <li aria-current="@(deviceConnected && guestConnected ? "step" : null)"><span>03</span> Share control</li>
      </ol>
    </section>
    @if (_state is null)
    {
      <InlineNotification Variant="@(_loaded ? "danger" : "info")" Role="@(_loaded ? "alert" : "status")">
        @(_loaded ? _notice.Message ?? "Unable to connect to the user service. Reload the page." : "Loading device connection...")
      </InlineNotification>
    }
    else
    {
      @if (_notice.Message is { } message)
      {
        <InlineNotification @key="message" CssClass="@(_notice.FadeOut ? "fading-notice" : null)" Variant="@(_notice.IsError ? "danger" : _noticeVariant)"
                            Role="@(_notice.IsError ? "alert" : "status")">@message</InlineNotification>
      }
      @if (!deviceConnected)
      {
        <section class="device-stage connection-sensitive" data-testid="device-connection" role="region" aria-labelledby="connection-heading">
          <div class="section-heading">
            <h2 id="connection-heading">Device connection</h2>
            <span class="status-mark connection-badge @ConnectionVariant @(ConnectionStatus == "Disconnected" ? "visually-hidden" : null)"
                  data-testid="device-connection-status" role="status">@ConnectionStatus</span>
          </div>
          <ossm-button type="button" class="button primary"
                  disabled="@(_busy || _safetyBusy || _connectionLost || _state.Device is { IsConnecting: true } or { IsConnected: true })"
                  @onclick="Connect">Connect device</ossm-button>
        </section>
      }
      <div class="session-dashboard connection-sensitive">
        <div class="session-workspace" data-testid="active-guest-workspace">
          <section class="session-controls" data-testid="user-controls">
            <div class="controls-summary">
              <h2 id="controls-heading">Session control</h2>
              <span class="status-mark @GuestVariant" data-testid="guest-status" role="status">@GuestStatus</span>
            </div>
            <div class="controls-content">
              <p class="section-description">Allow your guest to send settings. Stop remains available while you manage the session.</p>
              <div class="button-row">
                <ossm-button type="button" class="button primary"
                        disabled="@(_busy || _safetyBusy || DeviceUnavailable || _state.Device is { IsResettingPosition: true } || !_state.GuestJoined)"
                        @onclick="AllowGuest">Allow control</ossm-button>
                <ossm-button type="button" class="button danger" disabled="@_safetyBusy" @onclick="Stop">Stop</ossm-button>
                <ossm-button type="button" class="button warning" data-reset-position-button
                        disabled="@(_busy || _safetyBusy || DeviceUnavailable || _state.Device is { IsResettingPosition: true })"
                        @onclick="ResetPosition">Reset Position</ossm-button>
                <ossm-button type="button" class="button secondary" disabled="@(_safetyBusy || ConfirmingGuest || !_state.GuestJoined)" @onclick="EndGuest">End guest</ossm-button>
              </div>
              @if (_state.GuestSessionExpiresAt is { } expires)
              {
                <p class="session-expiry" data-testid="guest-session-expiry">Saved session expires <time datetime="@expires.ToString("O")">@expires.ToLocalTime().ToString("g")</time>.</p>
              }
            </div>
          </section>
          @if (deviceConnected && guestConnected)
          {
            <div class="preview-station">
              <PatternPreview Title="Last settings" Pattern="@_state.Device?.TransmittedSettings?.Pattern"
                              Speed="@_state.Device?.TransmittedSettings?.Speed" Stroke="@_state.Device?.TransmittedSettings?.Stroke"
                              Depth="@_state.Device?.TransmittedSettings?.Depth" Sensation="@_state.Device?.TransmittedSettings?.Sensation"
                              Animate="@(!_previewStopped && !_connectionLost && _state.Device is { IsConnected: true, IsConnecting: false, IsResettingPosition: false })" />
            </div>
          }
        </div>
        @if (ConfirmingGuest)
        {
          <InlineNotification Variant="warning" Role="alert">
            <p data-testid="guest-action-confirmation">@GuestDisconnectConfirmation</p>
            <div class="button-row">
              <ossm-button type="button" class="button danger" disabled="@(_safetyBusy || _connectionLost)"
                      @onclick="ConfirmGuest">Confirm guest action</ossm-button>
              <ossm-button type="button" class="button secondary" @onclick="CancelGuest">Cancel</ossm-button>
            </div>
          </InlineNotification>
        }
        <section class="invitation-desk" data-testid="guest-invitation-card" aria-labelledby="invite-heading">
          <details class="invitation-details" data-testid="invitation-details" open="@InvitationExpanded">
            <summary @onclick="ToggleInvitation" @onclick:preventDefault><h2 id="invite-heading">Private invitation</h2></summary>
            <div class="invitation-content">
              <p class="section-description">Share this link only with the person you want to join.</p>
              <div class="invite-row">
                <input id="guest-invitation" type="text" aria-label="Guest invitation"
                       data-testid="invitation-link" readonly disabled="@(DeviceUnavailable || _state.InvitationConsumed)" value="@InvitationText" />
                <ossm-button class="button @(_notice.IsCopied ? "success" : "primary")" type="button" disabled="@(DeviceUnavailable || _state.InvitationConsumed)"
                        @onclick="Copy" aria-label="@_notice.CopyLabel">@_notice.CopyLabel</ossm-button>
              </div>
              <div class="invitation-footer">
                <p data-testid="invitation-status">
                  @(_state.InvitationConsumed ? "This invitation has been used. Refresh it to invite someone else." : "This invitation can be used once.")
                  Refreshing ends the current guest session.
                </p>
                <ossm-button class="button @(_state.InvitationConsumed ? "primary" : "secondary")" type="button" disabled="@(_safetyBusy || ConfirmingGuest || _connectionLost)"
                        @onclick="RefreshInvitation" title="End the current guest session and create a new invitation">Refresh invitation</ossm-button>
              </div>
            </div>
          </details>
        </section>
      </div>
    }
  </ChildContent>
</ControlLayout>
