<Project>
  <PropertyGroup>
    <!-- The base target is for net10.0, and the native target framework is used for platform-specific builds. -->
    <BaseTargetFramework>net10.0</BaseTargetFramework>
    <TargetFramework>$(BaseTargetFramework)</TargetFramework>
    <NativeTargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(BaseTargetFramework)-windows10.0.19041.0</NativeTargetFramework>
    <NativeTargetFramework Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(BaseTargetFramework)-macos27.0</NativeTargetFramework>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DebugType Condition="'$(PublishProfile)' == 'win-x64'">embedded</DebugType>
    <AnalysisMode>latest-All</AnalysisMode>
    <ArtifactsPath>$(MSBuildThisFileDirectory).artifacts</ArtifactsPath>
    <VersionPrefix>0.1.0</VersionPrefix>
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
    <ApplicationDisplayVersion>$(VersionPrefix)</ApplicationDisplayVersion>
    <ApplicationVersion>$(VersionPrefix)</ApplicationVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RepositoryUrl>https://github.com/OssmSharp/OssmSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" />
  </ItemGroup>
</Project>
