# Store every text file with LF in the repository, and check it out with the
# platform's native endings so Windows editors and tools see CRLF.
* text=auto

*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
.bashrc text eol=lf
.zshrc text eol=lf
.profile text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.socket text eol=lf

*.gif binary
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
*.webp binary
*.zip binary
*.tar binary
*.gz binary
*.bz2 binary
*.xz binary
*.7z binary
