<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsTestProject>true</IsTestProject>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <StockMacOSApiVersion Condition="'$(StockMacOSApiVersion)' == ''">26.0</StockMacOSApiVersion>
        <TargetFramework Condition="'$(EnableStockBle)' == 'true' and $([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.19041.0</TargetFramework>
        <TargetFramework Condition="'$(EnableStockBle)' == 'true' and $([MSBuild]::IsOSPlatform('OSX'))">net10.0-macos$(StockMacOSApiVersion)</TargetFramework>
        <SupportedOSPlatformVersion Condition="'$(EnableStockBle)' == 'true' and $([MSBuild]::IsOSPlatform('OSX'))">26.0</SupportedOSPlatformVersion>
        <ApplicationId Condition="'$(EnableStockBle)' == 'true' and $([MSBuild]::IsOSPlatform('OSX'))">org.ossm.tests.cli</ApplicationId>
        <RunWithOpen>false</RunWithOpen>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/OssmSharp.Cli/OssmSharp.Cli.csproj" />
        <PackageReference Include="xunit.v3.mtp-v2" />
        <PackageReference Include="Microsoft.Testing.Platform" />
        <Using Include="Xunit" />
    </ItemGroup>
</Project>
