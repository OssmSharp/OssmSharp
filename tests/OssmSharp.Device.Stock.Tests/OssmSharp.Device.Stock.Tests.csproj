<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>OssmSharp.Device.Stock.Tests</RootNamespace>
    <TargetFramework Condition="'$(EnableStockBle)' == 'true' and $([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(EnableStockBle)' == 'true' and $([MSBuild]::IsOSPlatform('OSX'))">net10.0-macos26.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference
      Include="../../src/OssmSharp.Device.Primitives/OssmSharp.Device.Primitives.csproj" />
    <ProjectReference Include="../../src/OssmSharp.Device.Runtime/OssmSharp.Device.Runtime.csproj" />
    <ProjectReference Include="../../src/OssmSharp.Device.Stock/OssmSharp.Device.Stock.csproj" />
    <PackageReference Include="FastMoq.Core" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Microsoft.Testing.Platform" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <Using Include="OssmSharp.Device.Primitives" />
    <Using Include="OssmSharp.Device.Primitives.Models" />
    <Using Include="OssmSharp.Device.Stock" />
    <Using Include="OssmSharp.Device.Stock.Models" />
    <Using Include="OssmSharp.Device.Runtime" />
    <Using Include="FastMoq" />
    <Using Include="FastMoq.Extensions" />
    <Using Include="FastMoq.Providers" />
    <Using Include="Microsoft.Extensions.Time.Testing" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="Microsoft.Extensions.Logging.Abstractions" />
    <Using Include="Microsoft.Extensions.Options" />
    <Using Include="OneOf" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
